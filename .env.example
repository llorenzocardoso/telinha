VITE_API_URL=http://localhost:3001
# Produção: veja .env.production. Para .exe local: VITE_ALLOW_LOCAL_API=1
# Sem VITE_TURN_URL, o app usa os iceServers que o servidor devolve na sessão.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
# As flags do relay (TURN_ENABLED, TURN_MAX_BITRATE_KBPS) ficam no servidor: veja server/.env.example.
